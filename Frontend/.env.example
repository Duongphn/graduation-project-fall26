
VITE_APP_ENV=development
VITE_APP_NAME=ToyFlow

# --- Application Tier (Express + Socket.IO trên Render) ----------------
# REST API: Axios baseURL trong src/services/http.ts
VITE_API_URL=http://localhost:4000/api
# Socket.IO ( thông báo realtime). Cùng server với API, KHÔNG có /api.
VITE_SOCKET_URL=http://localhost:4000
VITE_API_TIMEOUT_MS=15000

# --- Đăng nhập Google -------------------------------------------------
# backend; backend giữ Google Client Secret và trả JWT về lại web.
# Để trống thì dùng mặc định: ${VITE_API_URL}/auth/google
VITE_GOOGLE_AUTH_URL=


VITE_ENABLE_DEMO_LOGIN=true
# Trang /dev/ui-kit và /dev/routes.
VITE_ENABLE_DEV_PAGES=true