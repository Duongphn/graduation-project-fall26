# Base URL của backend API. Bỏ trống để dùng /api/v1 (đi qua proxy của Vite khi dev)
VITE_API_BASE_URL=

# Khi chưa đăng nhập (chỉ dev): backend phải chạy với ALLOW_DEV_AUTH=true. VITE_DEV_ROLE=ADMIN để vào /admin.
# VITE_DEV_ROLE phải khớp role của user VITE_DEV_USER_ID trong database (backend đọc role từ DB,
# bỏ qua header role): sai lệch thì /admin vẫn mở nhưng mọi API admin trả 403.
VITE_DEV_USER_ID=
VITE_DEV_ROLE=ADMIN
