NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/toyflow
CORS_ORIGIN=http://localhost:5173

# Accept the x-dev-user-id header (an existing, unlocked user; role read from the database)
# until JWT login exists. Only with NODE_ENV=development or test; the server refuses to start
# with it in any other environment.
ALLOW_DEV_AUTH=false

# Swagger UI at /api/docs. Set true for local development only; never served in production.
API_DOCS_ENABLED=false

# Cloudinary (signed uploads, private image links and toy listing photos). Leave empty to
# disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (login with Google). Leave empty to disable Google login.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Email SMTP (OTP and password reset emails).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# JWT. Both secrets are required when NODE_ENV=production (the server refuses to start without
# them); development and test fall back to insecure local defaults.
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
