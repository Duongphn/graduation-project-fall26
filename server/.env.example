NODE_ENV=development
PORT=3000

# Rental flow requires MongoDB replica set for transactions (session.withTransaction)
# For local dev without Atlas:
# 1. Start mongod with a replica set: mongod --replSet rs0 --dbpath <data_dir>
# 2. In mongosh: rs.initiate()
MONGODB_URI=mongodb://127.0.0.1:27017/toyflow?replicaSet=rs0
CORS_ORIGIN=http://localhost:5173

# Rental scheduler
RENTAL_SCHEDULER_ENABLED=true

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Trợ lý AI tư vấn đồ chơi (POST /api/v1/ai/advisor). Key chỉ đặt ở server, KHÔNG commit file .env.
# false (mặc định): endpoint trả 503, các chức năng khác không bị ảnh hưởng.
AI_ADVISOR_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Quá thời gian này (ms) thì bỏ Gemini, trả kết quả tìm kiếm thường (fallback).
GEMINI_TIMEOUT_MS=8000
# Số lượt hỏi tối đa mỗi người mỗi ngày (câu trả lời từ FAQ không tính).
AI_ADVISOR_DAILY_LIMIT=20
