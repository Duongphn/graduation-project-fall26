NODE_ENV=development
PORT=3000

# Rental flow requires MongoDB replica set for transactions (session.withTransaction)
# For local dev without Atlas:
# 1. Start mongod with a replica set: mongod --replSet rs0 --dbpath <data_dir>
# 2. In mongosh: rs.initiate()
MONGODB_URI=mongodb://127.0.0.1:27017/toyflow?replicaSet=rs0
CORS_ORIGIN=http://localhost:5173

# Shared order timers job (rental & purchase orders)
# RENTAL_SCHEDULER_ENABLED=false is still accepted as an alias to disable the job.
ORDER_TIMERS_JOB_ENABLED=true
ORDER_TIMERS_JOB_INTERVAL_MINUTES=1

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
