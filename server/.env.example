NODE_ENV=development
PORT=3000

# Rental flow requires MongoDB replica set for transactions (session.withTransaction)
# For local dev without Atlas:
# 1. Start mongod with a replica set: mongod --replSet rs0 --dbpath <data_dir>
# 2. In mongosh: rs.initiate()
MONGODB_URI=mongodb://127.0.0.1:27017/toyflow?replicaSet=rs0
CORS_ORIGIN=http://localhost:5173
# Proxies in front of the API (set 1 on Render) and the /auth limit per IP per minute (0 = off)
TRUST_PROXY=0
AUTH_RATE_LIMIT_PER_MINUTE=10

# Shared order timers job (rental & purchase orders)
# RENTAL_SCHEDULER_ENABLED=false is still accepted as an alias to disable the job.
ORDER_TIMERS_JOB_ENABLED=true
ORDER_TIMERS_JOB_INTERVAL_MINUTES=1

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
# Render free blocks SMTP: set a Brevo API key to send through HTTPS instead.
# EMAIL_FROM must be a verified sender in Brevo (defaults to EMAIL_USER).
BREVO_API_KEY=
EMAIL_FROM=

# Required: the server will not start without both secrets (long random strings, at least 32 bytes)
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Trợ lý AI tư vấn đồ chơi (POST /api/v1/ai/toy-advice). Key chỉ đặt ở server, KHÔNG commit file .env.
# false (mặc định): endpoint trả 503, các chức năng khác không bị ảnh hưởng.
AI_ADVISOR_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Để trống (mặc định): chờ tới khi Gemini trả lời hoặc báo lỗi. Đặt số ms để tự chuyển sang fallback khi quá lâu.
GEMINI_TIMEOUT_MS=
# Số request tối đa gửi lên Gemini mỗi phút (cả hệ thống, theo hạn mức của key). Vượt thì xếp hàng
# chờ tối đa 30 giây, quá thì trả kết quả tìm kiếm thường. 0: không giới hạn.
GEMINI_RPM=15
# Số lượt hỏi tối đa mỗi người mỗi ngày (câu trả lời từ FAQ không tính).
AI_ADVISOR_DAILY_LIMIT=20

# UC12/13: cancel + refund purchase orders not shipped in 48h, auto-complete ones not confirmed in 7 days
PURCHASE_ORDER_TIMER_JOB_ENABLED=true

# PayOS (UC17 top-up by bank transfer QR — real money) — https://my.payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Frontend page PayOS redirects to after payment or cancel
PAYOS_RETURN_URL=http://localhost:5173/wallet/topup/payos-result
# Webhook URL to confirm in the PayOS dashboard: https://<public host>/api/v1/payments/payos-webhook
# Checks PayOS top-ups still pending after their link expired (credited if paid, else failed)
PAYMENT_EXPIRY_JOB_ENABLED=true
