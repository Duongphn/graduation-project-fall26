{
  "name": "toys_search",
  "analyzer": "vi_folding",
  "searchAnalyzer": "vi_folding",
  "analyzers": [
    {
      "name": "vi_folding",
      "charFilters": [],
      "tokenizer": {
        "type": "standard"
      },
      "tokenFilters": [
        {
          "type": "lowercase"
        },
        {
          "type": "icuFolding"
        }
      ]
    }
  ],
  "mappings": {
    "dynamic": false,
    "fields": {
      "title": {
        "type": "string",
        "analyzer": "vi_folding",
        "searchAnalyzer": "vi_folding"
      },
      "description": {
        "type": "string",
        "analyzer": "vi_folding",
        "searchAnalyzer": "vi_folding"
      },
      "status": {
        "type": "token"
      },
      "listingType": {
        "type": "token"
      },
      "categoryId": {
        "type": "objectId"
      },
      "ageRange": {
        "type": "document",
        "fields": {
          "minAge": {
            "type": "number"
          },
          "maxAge": {
            "type": "number"
          }
        }
      },
      "priceOrRate": {
        "type": "number"
      },
      "location": {
        "type": "geo"
      }
    }
  }
}
